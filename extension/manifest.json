{
  "manifest_version": 3,
  "name": "Aliasfill",
  "version": "1.2.0",
  "description": "Fake identities for sign-up forms, with disposable addresses from your own domain or alias service.",
  "permissions": ["alarms", "activeTab", "menus", "scripting", "storage"],
  "action": {
    "default_title": "Aliasfill",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/aliasfill.svg",
      "64": "icons/aliasfill.svg"
    }
  },
  "icons": {
    "32": "icons/aliasfill.svg",
    "64": "icons/aliasfill.svg",
    "128": "icons/aliasfill.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aliasfill@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": [
      "compat.js",
      "data/index.js",
      "data/be.js",
      "data/ca.js",
      "data/ch.js",
      "data/de.js",
      "data/es.js",
      "data/fr.js",
      "data/gb.js",
      "data/it.js",
      "data/nl.js",
      "data/us.js",
      "generator.js",
      "history.js",
      "throwaway.js",
      "providers/index.js",
      "providers/local.js",
      "providers/throwaway.js",
      "providers/simplelogin.js",
      "providers/addy.js",
      "providers/firefox-relay.js",
      "providers/fastmail.js",
      "providers/forward-email.js",
      "providers/duckduckgo.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["compat.js", "otp.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
